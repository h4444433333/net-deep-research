# ============================================================
# Net Deep Research CLI — local configuration template
# Usage: cp .env.example .env, then fill in your real API keys
# Note: .env is git-ignored; never commit real secrets
# ============================================================

# ---- Required: bring-your-own LLM (OpenAI-compatible endpoint) ----
LLM_API_KEY=<your-openai-compatible-api-key>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- Search (zero-config by default) ----
# Tavily key (https://tavily.com, free tier 1000 req/month); leave empty to use built-in scrapers
SEARCH_API_KEY=
# Search channel: auto = Tavily when key is set, else Bing scraping, then DuckDuckGo
#   Can also be pinned to: tavily | bing | duckduckgo
SEARCH_PROVIDER=auto
# SEARCH_MAX_RESULTS=5
# FETCH_TIMEOUT_SECONDS=12
# FETCH_MAX_CHARS=8000
# MAX_SEARCH_ROUNDS=3           # max multi-round search iterations
# MAX_SOURCES=8
# LLM_MAX_RETRIES=3             # LLM call retries (exponential backoff)

# ---- Backend integration ----
# Feedback output mode:
#   local  = save feedback-<session_id>.json locally only (no backend needed)
#   remote = POST to FEEDBACK_API_URL /v1/research-feedback; a citation passport
#            is issued automatically after acceptance
FEEDBACK_MODE=remote
FEEDBACK_API_URL=https://www.shoggoth.vip
